# Base URL of the backend API, including the /api suffix, no trailing slash.
# Local dev:
VITE_API_BASE_URL=http://localhost:5000/api
# Production (Vercel): use HTTPS, e.g.
# VITE_API_BASE_URL=https://veri-nest-dun.vercel.app/api
#
# NOTE: Vite bakes this value in at BUILD time, not runtime — after changing
# it in the Vercel dashboard you must REDEPLOY the frontend for it to apply.

# Google Sign-In: the OAuth 2.0 "Web application" Client ID from Google Cloud
# Console — the SAME value as the backend's GOOGLE_CLIENT_ID. Also baked in at
# build time. If unset, the "Sign in with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# reCAPTCHA v3 SITE key (public) from google.com/recaptcha/admin — pairs with
# the backend's RECAPTCHA_SECRET_KEY (which must NEVER appear here). Baked in
# at build time. If unset, forms submit without a token and the backend's
# dev fallback applies. Google's badge (bottom-right) must stay visible.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
