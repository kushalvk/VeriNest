# Server
PORT=5000
# Comma-separated list of origins allowed by CORS (frontend URLs).
# Use the exact scheme+host of the deployed frontend (a trailing slash is
# tolerated). Production example:
# ALLOWED_ORIGINS=https://veri-nest-tenant.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
# Base URL used for links inside outgoing emails (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/tenant-verification
# For MongoDB Atlas use the mongodb+srv://... string from the Atlas UI.
# Optional: force specific DNS servers for srv lookups (comma-separated).
# Only needed if your machine's DNS resolver can't resolve _mongodb._tcp SRV
# records (symptom: "querySrv ECONNREFUSED"); the app already auto-falls back
# to public DNS when the local resolver is loopback/unusable.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Cloudinary (file storage — documents, property images, agreement PDFs)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI chat assistant (Google Gemini)
GEMINI_API_KEY=your-gemini-key
# HF_API_KEY is reserved for future use — not currently required
HF_API_KEY=your-huggingface-key

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=user@example.com
EMAIL_SMTP_PASS=your-smtp-password
