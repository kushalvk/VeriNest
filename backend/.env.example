# Server
PORT=5000
# Comma-separated list of origins allowed by CORS (frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173
# Base URL used for links inside outgoing emails (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/tenant-verification

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Cloudinary (file storage — not integrated yet)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI providers (not integrated yet)
GEMINI_API_KEY=your-gemini-key
HF_API_KEY=your-huggingface-key

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=user@example.com
EMAIL_SMTP_PASS=your-smtp-password
