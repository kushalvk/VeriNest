# Server
PORT=5000
# Comma-separated list of origins allowed by CORS (frontend URLs).
# Use the exact scheme+host of the deployed frontend (a trailing slash is
# tolerated). Production example:
# ALLOWED_ORIGINS=https://veri-nest-tenant.vercel.app
ALLOWED_ORIGINS=http://localhost:5173
# Base URL used for links inside outgoing emails (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/tenant-verification
# For MongoDB Atlas use the mongodb+srv://... string from the Atlas UI.
# Optional: force specific DNS servers for srv lookups (comma-separated).
# Only needed if your machine's DNS resolver can't resolve _mongodb._tcp SRV
# records (symptom: "querySrv ECONNREFUSED"); the app already auto-falls back
# to public DNS when the local resolver is loopback/unusable.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Auth
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Google Sign-In: the OAuth 2.0 "Web application" Client ID from Google Cloud
# Console (same value as the frontend's VITE_GOOGLE_CLIENT_ID). Used server-side
# as the required audience when verifying Google ID tokens. If unset, the
# "Sign in with Google" endpoint returns a clear 503 instead of crashing, and a
# warning is logged at startup.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# reCAPTCHA v3 (bot protection on register/login) — the SECRET key from
# google.com/recaptcha/admin. Backend-only: never expose it via any VITE_
# variable. If unset, register/login run without bot checks and every such
# request logs a dev-fallback warning (fine locally, never in production).
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
# Optional: minimum score in [0,1] to accept (default 0.5). Raise if bots get
# through, lower if real users are blocked — see the reCAPTCHA admin console.
# RECAPTCHA_MIN_SCORE=0.5

# Cloudinary (file storage — documents, property images, agreement PDFs)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI chat assistant (Google Gemini)
GEMINI_API_KEY=your-gemini-key
# HF_API_KEY is reserved for future use — not currently required
HF_API_KEY=your-huggingface-key

# Email (SMTP)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=user@example.com
EMAIL_SMTP_PASS=your-smtp-password
